{
  "appId": "in.gov.ntro.sih26150.forensic",
  "productName": "NTRO DVR-NVR Forensic Analysis Tool",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**",
    "electron/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../backend/dist",
      "to": "bin",
      "filter": ["forensic-backend", "forensic-backend.exe"]
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "allowElevation": true,
    "perMachine": true
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility;Development",
    "executableName": "ntro-forensic"
  }
}
